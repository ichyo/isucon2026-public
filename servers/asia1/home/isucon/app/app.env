ISUREAL_EXP_QUANTUM=3600
ISUREAL_NODE=asia1
# HAProxy owns :80 on asia1 and balances asia1/asia2 (servers/asia1/etc/haproxy/haproxy.cfg)
ISUREAL_LISTEN=127.0.0.1:8080
ISUREAL_ACK_MODE=leader
ISUREAL_ASYNC_ACTIONS=create_post,create_comment,replace_real_moji,create_friend_request,follow,register,login,certify_user
