ISUREAL_EXP_QUANTUM=3600
ISUREAL_NODE=asia1
# HAProxy owns :80 on asia1 and balances asia1/asia2 (servers/asia1/etc/haproxy/haproxy.cfg)
ISUREAL_LISTEN=127.0.0.1:8080
ISUREAL_ACK_MODE=direct
# return freed memory to the OS immediately (abusive 10-32 MB uploads must not pin RSS)
MIMALLOC_PURGE_DELAY=0
# per-request TSV log for offline analysis (webapp-rs/src/accesslog.rs)
ISUREAL_ACCESS_LOG=/home/isucon/access.tsv
